# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=voucherdb
DB_USER=admin
DB_PASSWORD=securepassword123

# JWT Configuration (CHANGE IN PRODUCTION!)
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_IN_PRODUCTION_MIN_32_CHARS

# Admin Credentials (CHANGE IN PRODUCTION!)
ADMIN_EMAIL=admin@certjoin.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD_IN_PRODUCTION

# Partner Demo Credentials (CHANGE IN PRODUCTION!)
PARTNER_EMAIL=partner@certjoin.com
PARTNER_PASSWORD=CHANGE_THIS_PARTNER_PASSWORD_IN_PRODUCTION

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Server Configuration
PORT=8081
NODE_ENV=development

# Security Configuration
REFRESH_TOKEN_TTL_DAYS=7
SESSION_TIMEOUT_MINUTES=15
MAX_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# Moodle Integration
# URL base de tu instancia Moodle (sin barra final)
MOODLE_URL=https://moodle.tudominio.com
# Token de Web Services generado en el admin de Moodle
MOODLE_TOKEN=CHANGE_THIS_TO_YOUR_MOODLE_WS_TOKEN
# ID del rol estudiante en Moodle (5 = student por defecto)
MOODLE_ROLE_ID=5
# 'true' para simular localmente sin Moodle real; 'false' en producción
MOODLE_MOCK=true
MOODLE_SYNC_INTERVAL_MINUTES=60
# Secret para el webhook receptor de eventos de Moodle (genera uno aleatorio largo)
# MOODLE_WEBHOOK_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET
# URL pública de Moodle para el enlace de acceso en los correos (si difiere de MOODLE_URL)
# MOODLE_PUBLIC_URL=https://moodle.tudominio.com

# Email / SMTP (notificación de bienvenida al estudiante)
# 'true' para enviar correos; 'false' deshabilita (solo loguea, no envía)
MAIL_ENABLED=true
# Host SMTP — local: 'mailpit' (mail-catcher) | QA/PD: SMTP real por definir
SMTP_HOST=mailpit
# Puerto SMTP — local Mailpit: 1025 | SMTP real: 587 (STARTTLS) o 465 (TLS)
SMTP_PORT=1025
# 'true' para TLS implícito (puerto 465); 'false' en local y para 587
SMTP_SECURE=false
# Credenciales SMTP — vacías en local; usuario/contraseña (o app-password) en QA/PD
SMTP_USER=
SMTP_PASS=
# Remitente
MAIL_FROM=no-reply@certjoin.com
MAIL_FROM_NAME=CertJoin
# Reply-To opcional
MAIL_REPLY_TO=
# URL pública del logo CertJoin para la cabecera del correo (vacío = título de marca en texto)
MAIL_LOGO_URL=
# URL del botón "Campus" del correo de bienvenida (por defecto el campus de producción)
CAMPUS_URL=https://campus.certjoin.com/
