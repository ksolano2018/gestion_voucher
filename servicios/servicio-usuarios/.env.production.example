# ============================================================================
# .env de la APLICACIÓN — PRODUCCIÓN (servicio-usuarios)
# ----------------------------------------------------------------------------
# Este archivo es la config de la app. docker-compose lo pasa como env_file a
# servicio-usuarios y también a los microservicios (compras, moodle, notificaciones).
#
# 1) Copia a  servicios/servicio-usuarios/.env  (en el VPS).
# 2) Rellena los CAMBIAR_*.  3) NUNCA subir a git.  chmod 600 el .env.
# Secretos fuertes sugeridos:  openssl rand -hex 32
# ============================================================================

# --- Base de datos (coincide con el .env raíz; DB_HOST=postgres es el contenedor) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=voucherdb
DB_USER=admin
DB_PASSWORD=CAMBIAR_password_db_fuerte

# --- Seguridad / sesión ---
JWT_SECRET=CAMBIAR_secreto_jwt_fuerte
NODE_ENV=production
PORT=8081
SESSION_TIMEOUT_MINUTES=30        # vida del access token (JWT)
REFRESH_TOKEN_TTL_DAYS=7          # tope absoluto del refresh token
REFRESH_IDLE_MINUTES=30           # cierre por inactividad (ventana deslizante)
MAX_LOGIN_ATTEMPTS=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# --- Usuarios semilla (se crean en el primer arranque si no existen) ---
# SEED_FORCE_PASSWORD_CHANGE=true → admin y soporte deben cambiar la contraseña en el
# primer login (entregas una TEMPORAL y no conoces la definitiva). En PRD: true.
SEED_FORCE_PASSWORD_CHANGE=true
ADMIN_EMAIL=admin@certjoin.com
ADMIN_PASSWORD=CAMBIAR_password_admin_TEMPORAL
PARTNER_EMAIL=partner@certjoin.com
PARTNER_PASSWORD=CAMBIAR_password_partner_TEMPORAL
# Cuenta de SOPORTE (nuestra): rol 'soporte' = admin operativo SIN gestión de usuarios/roles.
# Si defines SUPPORT_EMAIL + SUPPORT_PASSWORD se crea al primer arranque.
SUPPORT_EMAIL=soporte@orkusit.com
SUPPORT_PASSWORD=CAMBIAR_password_soporte_TEMPORAL

# --- URL pública de la app (subdominio detrás de CloudPanel) ---
# Se usa para CORS, enlaces y el retorno de Stripe. DEBE ser el subdominio con https.
FRONTEND_URL=https://CAMBIAR_subdominio.tudominio.com

# --- Stripe (cuenta del cliente, modo live) ---
STRIPE_PUBLISHABLE_KEY=pk_live_CAMBIAR
STRIPE_SECRET_KEY=sk_live_CAMBIAR
# Webhook configurado en Stripe apuntando a https://<subdominio>/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_CAMBIAR

# --- Moodle EXTERNO del cliente (no dockerizado en PD) ---
MOODLE_MOCK=false
# URL base del Moodle del cliente, accesible desde el VPS (sin barra final).
MOODLE_URL=https://CAMBIAR_moodle.tudominio.com
# Token de Web Services (servicio externo con las 9 funciones que usa la app).
MOODLE_TOKEN=CAMBIAR_token_ws_moodle
# ID del rol de estudiante en su Moodle (por defecto 5).
MOODLE_ROLE_ID=5
# URL pública del Moodle (para enlaces); normalmente igual que MOODLE_URL.
MOODLE_PUBLIC_URL=https://CAMBIAR_moodle.tudominio.com
# URL del botón "Campus" del correo de bienvenida (login del Moodle del cliente).
CAMPUS_URL=https://CAMBIAR_moodle.tudominio.com/login/index.php

# --- Correo / SMTP del cliente ---
MAIL_ENABLED=true
SMTP_HOST=CAMBIAR_smtp_host
SMTP_PORT=465
SMTP_SECURE=true                  # true para 465 (SSL), false para 587 (STARTTLS)
SMTP_USER=CAMBIAR_smtp_user
SMTP_PASS=CAMBIAR_smtp_pass
MAIL_FROM=CAMBIAR_remitente@tudominio.com
MAIL_FROM_NAME=CertJoin
MAIL_REPLY_TO=CAMBIAR_replyto@tudominio.com
# (Opcional) URL pública de un logo para la cabecera del correo.
MAIL_LOGO_URL=
