# ============================================================================
# Configuración RAÍZ para docker-compose — PRODUCCIÓN (VPS)
# ----------------------------------------------------------------------------
# 1) Copia este archivo a  .env  (en la raíz del proyecto).
# 2) Rellena los valores marcados con CAMBIAR_*.
# 3) NUNCA subas el .env a git (está en .gitignore).
# Permisos sugeridos:  chmod 600 .env
# ============================================================================

# --- Base de datos PostgreSQL ---
DB_NAME=voucherdb
DB_USER=admin
DB_PASSWORD=CAMBIAR_password_db_fuerte

# --- Perfiles de docker-compose ---
# 'local-moodle' levanta el Moodle dockerizado (+ su MariaDB) dentro del stack.
# Si usas un Moodle EXTERNO ya existente, deja esto VACÍO (COMPOSE_PROFILES=)
# y apunta MOODLE_URL al Moodle externo en el .env del servicio-usuarios.
COMPOSE_PROFILES=local-moodle

# --- Moodle dockerizado (solo si COMPOSE_PROFILES incluye local-moodle) ---
# URL pública EXACTA con la que los usuarios acceden a Moodle (debe coincidir,
# si no Moodle redirige). Ej. http://TU_IP:8095  o  https://moodle.tudominio.com
MOODLE_SITE_URL=http://CAMBIAR_IP_O_DOMINIO:8095
# Contraseña del admin de Moodle. OJO: se aplica en la PRIMERA instalación;
# luego cámbiala desde la UI de Moodle.
MOODLE_ADMIN_PASSWORD=CAMBIAR_admin_moodle