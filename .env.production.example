# ============================================================================
# .env RAÍZ para docker-compose — PRODUCCIÓN (VPS del cliente, detrás de CloudPanel)
# ----------------------------------------------------------------------------
# 1) Copia este archivo a  .env  (en la raíz del proyecto, en el VPS).
# 2) Rellena los valores CAMBIAR_*.
# 3) NUNCA subas el .env a git (está en .gitignore).  chmod 600 .env
#
# Este .env solo alimenta a docker-compose (interpolación de variables). La config
# de la APP va en  servicios/servicio-usuarios/.env  (ver .env.production.example ahí).
# ============================================================================

# --- Base de datos PostgreSQL (interna, en el contenedor) ---
DB_NAME=voucherdb
DB_USER=admin
DB_PASSWORD=CAMBIAR_password_db_fuerte

# --- Moodle EXTERNO del cliente ---
# En PD NO se despliega el Moodle dockerizado → COMPOSE_PROFILES vacío.
# (La URL/token del Moodle del cliente van en servicios/servicio-usuarios/.env → MOODLE_URL/MOODLE_TOKEN.)
COMPOSE_PROFILES=

# --- Ingreso detrás de CloudPanel (reverse proxy + TLS) ---
# El gateway se publica SOLO en localhost; CloudPanel (NGINX) le hace proxy y pone el HTTPS.
GATEWAY_PORT=3000
GATEWAY_BIND=127.0.0.1
# No exponer Postgres ni la API directa a internet: solo localhost (o red interna).
DB_BIND=127.0.0.1
USUARIOS_BIND=127.0.0.1

# --- Token interno compartido entre microservicios (genera uno fuerte) ---
INTERNAL_API_TOKEN=CAMBIAR_token_interno_fuerte
